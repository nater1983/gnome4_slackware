+void
+_gdata_service_parse_soup_error (GDataService *self, GError **error)
+{
+	GError *inerr;
+
+	if (!error || !*error)
+		return;
+
+	inerr = *error;
+	*error = NULL;
+
+	if (inerr->domain == SOUP_SESSION_ERROR) {
+		switch (inerr->code) {
+			case SOUP_SESSION_ERROR_PARSING:
+			case SOUP_SESSION_ERROR_ENCODING: {
+				real_parse_error_response (self, 0, SOUP_STATUS_BAD_REQUEST,
+				                           inerr->message, NULL, 0, error);
+				g_error_free (inerr);
+				return;
+			}
+		}
+	}
+
+	if (inerr->domain == G_IO_ERROR) {
+		switch (inerr->code) {
+			case G_IO_ERROR_PROXY_FAILED:
+			case G_IO_ERROR_PROXY_NOT_ALLOWED:
+			case G_IO_ERROR_PROXY_NEED_AUTH:
+				g_set_error (error, GDATA_SERVICE_ERROR, GDATA_SERVICE_ERROR_PROXY_ERROR,
+				             _("Cannot connect to the proxy server."));
+				g_error_free (inerr);
+				return;
+		}
+	}
+
+	g_set_error (error, GDATA_SERVICE_ERROR, GDATA_SERVICE_ERROR_NETWORK_ERROR,
+	             _("Cannot connect to the serviceâ€™s server."));
+	g_error_free (inerr);
