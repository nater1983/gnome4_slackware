-	g_assert (priv->response_status == SOUP_STATUS_NONE);
-	g_assert (priv->response_error == NULL);
-
-	g_mutex_lock (&(priv->write_mutex));
-	is_finished = (priv->state == STATE_FINISHED);
-	g_mutex_unlock (&(priv->write_mutex));
