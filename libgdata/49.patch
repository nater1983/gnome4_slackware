+static SoupMessage *
+build_message (GDataUploader *self, GDataService *service, const gchar *method, const gchar *upload_uri)
+{
+	SoupMessage *new_message;
+	GUri *_uri, *_uri_parsed;
+
+	/* Build the message */
+	_uri_parsed = g_uri_parse (upload_uri, SOUP_HTTP_URI_FLAGS, NULL);
+	_uri = soup_uri_copy (_uri_parsed, SOUP_URI_PORT,
+	                      _gdata_service_get_https_port (), SOUP_URI_NONE);
+	g_uri_unref (_uri_parsed);
+	new_message = _gdata_service_new_message_from_uri (service, method, _uri);
+	g_uri_unref (_uri);
+
+	return new_message;
+}
