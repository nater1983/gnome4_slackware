+	soup_message_body_append (uhm_message_get_response_body (message), SOUP_MEMORY_STATIC, "Request timed out.", strlen ("Request timed out.") + 1);
+	soup_message_body_complete (uhm_message_get_response_body (message));
 
 	return TRUE;
 }
