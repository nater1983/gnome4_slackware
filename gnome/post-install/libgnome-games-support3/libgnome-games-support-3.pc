prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/@LIB@

Name: libgnome-games-support-3
Description: Useful functionality shared among GNOME games
Version: @VERSION@
Requires: libadwaita-1 >= 1.0 gee-0.8 >=  0.14.0, gio-2.0 >=  2.40.0, glib-2.0 >=  2.40.0, gtk4 >=  4.2.0
Libs: -L${libdir} -lgnome-games-support-3
Cflags: -I${includedir}/gnome-games-support-3
