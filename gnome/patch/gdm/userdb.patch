diff --git a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -84,7 +84,25 @@
 else
   elogind_dep = dependency('libelogind')
   logind_dep = elogind_dep
-  have_userdb = false
-  greeter_uid_min = 0
-  greeter_uid_max = 0
+
+  # Check that elogind provides the Varlink and JSON APIs required by GDM.
+  have_userdb = cc.links('''
+    #include <systemd/sd-varlink.h>
+    #include <systemd/sd-json.h>
+
+    int main(void) {
+      sd_varlink_server *server = NULL;
+      sd_json_variant *json = NULL;
+
+      sd_varlink_server_new(&server, SD_VARLINK_SERVER_INHERIT_USERDATA);
+      sd_json_buildo(&json, SD_JSON_BUILD_PAIR_BOOLEAN(\"test\", 1));
+
+      sd_varlink_server_unref(server);
+      sd_json_variant_unref(json);
+      return 0;
+    }
+  ''', dependencies: elogind_dep)
+
+  if have_userdb
+    greeter_uid_min = 60578
+    greeter_uid_max = 60705
+  else
+    greeter_uid_min = 0
+    greeter_uid_max = 0
+  endif
 endif
"""
path = "/mnt/data/gdm-51.1.1-elogind-userdb.patch"
with open(path, "w", newline="\n") as f:
    f.write(patch)
print(path)
