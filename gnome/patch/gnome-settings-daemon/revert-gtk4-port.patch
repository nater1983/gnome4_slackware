+static gpointer
+is_wayland_session (gpointer user_data)
+{
+#if HAVE_WAYLAND
+        struct wl_display *display;
+
+        display = wl_display_connect (NULL);
+        if (!display)
+                return GUINT_TO_POINTER(FALSE);
+        wl_display_disconnect (display);
+        return GUINT_TO_POINTER(TRUE);
+#else
+        return GUINT_TO_POINTER(FALSE);
+#endif
+}
