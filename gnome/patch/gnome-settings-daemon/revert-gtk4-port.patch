+gnome_settings_is_wayland (void)
+{
+        static GOnce wayland_once = G_ONCE_INIT;
+
+        g_once (&wayland_once, is_wayland_session, NULL);
+
+        return GPOINTER_TO_UINT(wayland_once.retval);
+}
