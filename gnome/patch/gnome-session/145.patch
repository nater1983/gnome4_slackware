From 7d4176686d3789e286d8ecb6236f8d34268bbeb4 Mon Sep 17 00:00:00 2001
From: Adrian Vovk <adrianvovk@gmail.com>
Date: Mon, 7 Jul 2025 17:37:47 -0400
Subject: [PATCH 49/51] app: Rework handling of phase

First, we no longer need to store the app's phase because it's always
going to be APPLICATION now. We can assume that.

Second, we now refuse to load apps that set a phase other than
Application. This prevents us from trying to launch services that have
yet to port to systemd unit files
---
 gnome-session/gsm-app.c     | 66 ++++++++-----------------------------
 gnome-session/gsm-app.h     |  3 +-
 gnome-session/gsm-manager.c |  8 -----
 3 files changed, 16 insertions(+), 61 deletions(-)

diff --git a/gnome-session/gsm-app.c b/gnome-session/gsm-app.c
index 7090269a..2b6cd6e3 100644
--- a/gnome-session/gsm-app.c
+++ b/gnome-session/gsm-app.c
@@ -54,14 +54,11 @@ struct _GsmApp
 {
         GObject          parent;
         GDesktopAppInfo *inner;
-
-        int              phase;
 };
 
 enum {
         PROP_0,
         PROP_INNER,
-        PROP_PHASE,
         LAST_PROP
 };
 
@@ -82,15 +79,6 @@ gsm_app_set_inner (GsmApp          *app,
         g_set_object (&app->inner, app_info);
 }
 
-static void
-gsm_app_set_phase (GsmApp *app,
-                   int     phase)
-{
-        g_return_if_fail (GSM_IS_APP (app));
-
-        app->phase = phase;
-}
-
 static void
 gsm_app_set_property (GObject      *object,
                       guint         prop_id,
@@ -103,9 +91,6 @@ gsm_app_set_property (GObject      *object,
         case PROP_INNER:
                 gsm_app_set_inner (app, g_value_get_object (value));
                 break;
-        case PROP_PHASE:
-                gsm_app_set_phase (app, g_value_get_int (value));
-                break;
         default:
                 break;
         }
@@ -123,9 +108,6 @@ gsm_app_get_property (GObject    *object,
         case PROP_INNER:
                 g_value_set_object (value, app->inner);
                 break;
-        case PROP_PHASE:
-                g_value_set_int (value, app->phase);
-                break;
         default:
                 break;
         }
@@ -157,15 +139,6 @@ gsm_app_class_init (GsmAppClass *klass)
                                                               "Inner",
                                                               G_TYPE_DESKTOP_APP_INFO,
                                                               G_PARAM_READWRITE | G_PARAM_CONSTRUCT_ONLY));
-        g_object_class_install_property (object_class,
-                                         PROP_PHASE,
-                                         g_param_spec_int ("phase",
-                                                           "Phase",
-                                                           "Phase",
-                                                           -1,
-                                                           G_MAXINT,
-                                                           -1,
-                                                           G_PARAM_READWRITE | G_PARAM_CONSTRUCT_ONLY));
 }
 
 const char *
@@ -176,22 +149,6 @@ gsm_app_peek_app_id (GsmApp *app)
         return g_app_info_get_id (G_APP_INFO (app->inner));
 }
 
-/**
- * gsm_app_peek_phase:
- * @app: a %GsmApp
- *
- * Returns @app's startup phase.
- *
- * Return value: @app's startup phase
- **/
-GsmManagerPhase
-gsm_app_peek_phase (GsmApp *app)
-{
-        g_return_val_if_fail (GSM_IS_APP (app), GSM_MANAGER_PHASE_APPLICATION);
-
-        return app->phase;
-}
-
 gboolean
 gsm_app_peek_is_disabled (GsmApp *app)
 {
@@ -299,14 +256,22 @@ gsm_app_start (GsmApp  *app,
 }
 
 GsmApp *
-gsm_app_new (GDesktopAppInfo  *info)
+gsm_app_new (GDesktopAppInfo  *info,
+             GError          **error)
 {
+        g_autofree char *app_phase = NULL;
+
         g_return_val_if_fail (info != NULL, NULL);
 
-        return g_object_new (GSM_TYPE_APP,
-                             "inner", info,
-                             "phase", GSM_MANAGER_PHASE_APPLICATION,
-                             NULL);
+        app_phase = g_desktop_app_info_get_string (info, GSM_APP_PHASE_KEY);
+        if (app_phase && strcmp (app_phase, "Application") != 0) {
+                g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                             "App %s sets " GSM_APP_PHASE_KEY ", but gnome-session no longer manages session services",
+                             g_app_info_get_id (G_APP_INFO(info)));
+                return NULL;
+        }
+
+        return g_object_new (GSM_TYPE_APP, "inner", info, NULL);
 }
 
 GsmApp *
@@ -314,7 +279,6 @@ gsm_app_new_for_path (const char  *path,
                       GError     **error)
 {
         g_autoptr (GDesktopAppInfo) info = NULL;
-        GsmApp *app = NULL;
 
         g_return_val_if_fail (path != NULL, NULL);
 
@@ -326,7 +290,5 @@ gsm_app_new_for_path (const char  *path,
                 return NULL;
