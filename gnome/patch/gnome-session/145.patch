From e4fac1586cce560b8c86791b1e6aa5eda6b71b7d Mon Sep 17 00:00:00 2001
From: Adrian Vovk <adrianvovk@gmail.com>
Date: Wed, 4 Jun 2025 18:34:25 -0400
Subject: [PATCH 02/51] main: Don't set XDG_CURRENT_DESKTOP

This is set by GDM (and other display managers) for over 10 years, and
really should be configured in the xsession/wayland-session file

If it isn't, then chances are you're _not_ running GNOME and thus we
really shouldn't set the variable
---
 gnome-session/main.c | 9 ---------
 1 file changed, 9 deletions(-)

diff --git a/gnome-session/main.c b/gnome-session/main.c
index 47abd43e..8eb7d504 100644
--- a/gnome-session/main.c
+++ b/gnome-session/main.c
@@ -449,15 +449,6 @@ main (int argc, char **argv)
         if (!g_getenv ("DBUS_SESSION_BUS_ADDRESS"))
                 g_error ("No session bus running! Cannot continue");
 
-        /* From 3.14 GDM sets XDG_CURRENT_DESKTOP. For compatibility with
-         * older versions of GDM,  other display managers, and startx,
-         * set a fallback value if we don't find it set.
-         */
-        if (g_getenv ("XDG_CURRENT_DESKTOP") == NULL) {
-            g_setenv("XDG_CURRENT_DESKTOP", "GNOME", TRUE);
-            gsm_util_setenv ("XDG_CURRENT_DESKTOP", "GNOME");
-        }
-
         /* Make sure we initialize gio in a way that does not autostart any daemon */
         initialize_gio ();
 
-- 
GitLab


