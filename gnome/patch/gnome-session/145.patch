+                        GError          **error)
+{
+        g_autoptr(GVariant) result = NULL;
+        const char *object_path = NULL;
+        g_autoptr(GDBusProxy) unit_proxy = NULL;
+        const char *active_state = NULL;
+
+        result = g_dbus_connection_call_sync (connection,
