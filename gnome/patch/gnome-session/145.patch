 gnome-session/leader-main.c    | 197 ++++++++++++++++++++++++++++-----
 gnome-session/meson.build      |  17 +--
 3 files changed, 169 insertions(+), 84 deletions(-)
 delete mode 100755 gnome-session/gnome-session.in

