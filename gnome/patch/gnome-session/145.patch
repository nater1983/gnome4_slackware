From 28a7eb8b9ce32a14cb7d896d3a74fb387f0e7ee9 Mon Sep 17 00:00:00 2001
From: Adrian Vovk <adrianvovk@gmail.com>
Date: Wed, 4 Jun 2025 18:32:41 -0400
Subject: [PATCH 01/51] main: Require a running session bus

Previously, without a running session bus we'd dbus-launch a session
bus. Nowadays there's no session bus, and instead we have a user bus
managed by the user's service manager (i.e. systemd)

Let's rather fail than trying to stand up a session in an unsupported
configuration (i.e. via dbus-launch)
---
 gnome-session/main.c | 45 ++------------------------------------------
 1 file changed, 2 insertions(+), 43 deletions(-)

diff --git a/gnome-session/main.c b/gnome-session/main.c
index b8af0e03..47abd43e 100644
--- a/gnome-session/main.c
+++ b/gnome-session/main.c
@@ -187,46 +187,6 @@ acquire_name (void)
                                NULL, NULL);
 }
 
-static gboolean
-require_dbus_session (int      argc,
-                      char   **argv,
-                      GError **error)
-{
-        char **new_argv;
-        int    i;
-
-        if (g_getenv ("DBUS_SESSION_BUS_ADDRESS"))
-                return TRUE;
-
-        /* Just a sanity check to prevent infinite recursion if
-         * dbus-launch fails to set DBUS_SESSION_BUS_ADDRESS 
-         */
-        g_return_val_if_fail (!g_str_has_prefix (argv[0], "dbus-launch"),
-                              TRUE);
-
-        /* +2 for our new arguments, +1 for NULL */
-        new_argv = g_malloc ((argc + 3) * sizeof (*argv));
-
-        new_argv[0] = "dbus-launch";
-        new_argv[1] = "--exit-with-session";
-        for (i = 0; i < argc; i++) {
-                new_argv[i + 2] = argv[i];
-        }
-        new_argv[i + 2] = NULL;
-        
-        if (!execvp ("dbus-launch", new_argv)) {
-                g_set_error (error, 
-                             G_SPAWN_ERROR,
-                             G_SPAWN_ERROR_FAILED,
-                             "No session bus and could not exec dbus-launch: %s",
-                             g_strerror (errno));
-                return FALSE;
-        }
-
-        /* Should not be reached */
-        return TRUE;
-}
-
 static void
 initialize_gio (void)
 {
@@ -486,9 +446,8 @@ main (int argc, char **argv)
         };
 
         /* Make sure that we have a session bus */
-        if (!require_dbus_session (argc, argv, &error)) {
-                gsm_util_init_error (TRUE, "%s", error->message);
-        }
+        if (!g_getenv ("DBUS_SESSION_BUS_ADDRESS"))
+                g_error ("No session bus running! Cannot continue");
 
         /* From 3.14 GDM sets XDG_CURRENT_DESKTOP. For compatibility with
          * older versions of GDM,  other display managers, and startx,
