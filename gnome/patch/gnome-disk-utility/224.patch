From 81fa1aebe4f5d50de704738e04a955f9569566b9 Mon Sep 17 00:00:00 2001
From: Adrian Vovk <adrianvovk@gmail.com>
Date: Thu, 31 Jul 2025 20:51:18 -0400
Subject: [PATCH 1/2] notify: Switch to systemd service

Starting with GNOME 49, gnome-session no longer uses .desktop files to
launch session services. Instead, only systemd is used
---
 meson.build                                           |  7 +++++++
 src/notify/gnome-disk-utility-notify.service.in       | 11 +++++++++++
 src/notify/meson.build                                |  6 +++---
 ....gnome.SettingsDaemon.DiskUtilityNotify.desktop.in |  7 -------
 4 files changed, 21 insertions(+), 10 deletions(-)
 create mode 100644 src/notify/gnome-disk-utility-notify.service.in
 delete mode 100644 src/notify/org.gnome.SettingsDaemon.DiskUtilityNotify.desktop.in

diff --git a/meson.build b/meson.build
index cb12c181c..67c5b23c2 100644
--- a/meson.build
+++ b/meson.build
@@ -103,6 +103,13 @@ config_h.set(
   description: 'Define to 1 if logind API is available',
 )
 
+systemd = dependency('systemd', required : false)
+systemd_user_unit_dir = systemd.get_variable(
+    'systemd_user_unit_dir',
+    pkgconfig_define : ['prefix', gdu_prefix],
+    default_value: gdu_prefix / 'lib' / 'systemd' / 'user'
+)
+
 # configure rust
 cargo = find_program('cargo', required: true)
 
diff --git a/src/notify/gnome-disk-utility-notify.service.in b/src/notify/gnome-disk-utility-notify.service.in
new file mode 100644
index 000000000..75b25b71d
--- /dev/null
+++ b/src/notify/gnome-disk-utility-notify.service.in
@@ -0,0 +1,11 @@
+[Unit]
+Description=Disk Health Notifications
+PartOf=gnome-session.target
+After=gnome-session.target
+
+[Service]
+Type=dbus
+BusName=org.gnome.Disks.NotificationMonitor
+ExecStart=@libexecdir@/gnome-disk-utility-notify
+Restart=on-failure
+Slice=app.slice
diff --git a/src/notify/meson.build b/src/notify/meson.build
index 8ef29ff71..2afad3f46 100644
--- a/src/notify/meson.build
+++ b/src/notify/meson.build
@@ -11,7 +11,7 @@ deps = [
 ]
 
 executable(
-  'gsd-disk-utility-notify',
+  'gnome-disk-utility-notify',
   sources,
   include_directories: top_inc,
   dependencies: deps,
@@ -21,9 +21,9 @@ executable(
 
 
 configure_file(
-  input: 'org.gnome.SettingsDaemon.DiskUtilityNotify.desktop.in',
+  input: 'gnome-disk-utility-notify.service.in',
   output: '@BASENAME@',
   configuration: {'libexecdir': gdu_prefix / gdu_libexecdir},
   install: true,
-  install_dir: gdu_sysconfdir / 'xdg/autostart',
+  install_dir: systemd_user_unit_dir,
 )
diff --git a/src/notify/org.gnome.SettingsDaemon.DiskUtilityNotify.desktop.in b/src/notify/org.gnome.SettingsDaemon.DiskUtilityNotify.desktop.in
deleted file mode 100644
index 8e2a561b6..000000000
--- a/src/notify/org.gnome.SettingsDaemon.DiskUtilityNotify.desktop.in
+++ /dev/null
@@ -1,7 +0,0 @@
-[Desktop Entry]
-Type=Application
-Name=gnome-disk-utility notification plugin for GNOME Settings Daemon
-Exec=@libexecdir@/gsd-disk-utility-notify
-OnlyShowIn=GNOME;
-NoDisplay=true
-X-GNOME-AutoRestart=true
-- 
