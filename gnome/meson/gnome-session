git clone https://github.com/fulalas/gnome-session-sysvinit tmp
cp -av tmp/* tmp/.* . 2>/dev/null
rm -rf tmp

mkdir build
cd build
  CFLAGS="$SLKCFLAGS" \
  CXXFLAGS="$SLKCFLAGS" \
  meson setup ..\
    "${GNOME_BUILD_ARGS[@]}" \
    $GNOME_OPT_ARGS \
	  -Dlogind_provider=elogind \
    -Ddocbook=false
  "${NINJA:=ninja}"
  DESTDIR=$PKG $NINJA install
cd ..
