sed -i "s/glib_ver = '>= 2.89.0'/glib_ver = '>= 2.88.0'/" meson.build

mkdir build
cd build
  CFLAGS="$SLKCFLAGS" \
  CXXFLAGS="$SLKCFLAGS" \
  meson setup ..\
    "${GNOME_BUILD_ARGS[@]}" \
    $GNOME_OPT_ARGS \
    -Ddocs=false \
    -Dextensions=true \
    -Dintrospection=true \
    -Dpackagekit=false \
    -Dselinux=false \
    -Dtests=none 
  "${NINJA:=ninja}"
  DESTDIR=$PKG $NINJA install
cd ..
