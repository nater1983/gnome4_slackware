rm -fr po
cat > subprojects/po.wrap << 'EOF'
[wrap-git]
directory=po
url=https://github.com/dialect-app/po.git
revision=head
EOF
mv subprojects/po ./po

mkdir build
cd build
  CFLAGS="$SLKCFLAGS" \
  CXXFLAGS="$SLKCFLAGS" \
  meson setup ..\
    "${GNOME_BUILD_ARGS[@]}" \
    $GNOME_OPT_ARGS
  "${NINJA:=ninja}"
  DESTDIR=$PKG $NINJA install
cd ..
