mkdir cmake-build
cd cmake-build
  cmake .. \
    -DCMAKE_C_FLAGS:STRING="$SLKCFLAGS -fno-strict-aliasing" \
    -DCMAKE_CXX_FLAGS:STRING="$SLKCFLAGS -fno-strict-aliasing" \
    "${GNOME_CMAKE_ARGS[@]}" \
     -G Ninja \
     -DGLM_BUILD_LIBRARY=ON
    "${NINJA:=ninja}"
  DESTDIR=$PKG $NINJA install
cd ..
