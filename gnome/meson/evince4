mkdir build
cd build
  CFLAGS="$SLKCFLAGS -DHAVE_STRING_H -DHAVE_STDLIB_H" \
  CXXFLAGS="$SLKCFLAGS -DHAVE_STRING_H -DHAVE_STDLIB_H" \
  meson setup ..\
    "${GNOME_BUILD_ARGS[@]}" \
    $GNOME_OPT_ARGS \
    -Dplatform=gnome \
    -Dviewer=false \
    -Dpreviewer=false \
    -Dthumbnailer=true \
    -Dnautilus=false \
    -Dcomics=disabled \
    -Ddjvu=disabled \
    -Dpdf=disabled \
    -Dps=disabled \
    -Dtiff=disabled \
    -Dxps=disabled \
    -Dgtk_doc=false \
    -Duser_doc=false \
    -Dintrospection=true \
    -Ddbus=true \
    -Dkeyring=disabled \
    -Dgtk_unix_print=disabled \
    -Dthumbnail_cache=disabled \
    -Dsystemduserunitdir=no
  "${NINJA:=ninja}"
  DESTDIR=$PKG $NINJA install
cd ..
