rm -f {configure.ac,configure,Makefile*}
sed -i "/debugedit = find_program('debugedit', version: '>= 5.0')/d" meson.build
sed -i "/config_data.set_quoted('DEBUGEDIT', debugedit.full_path())/d" src/meson.build

mkdir build
cd build
  CFLAGS="$SLKCFLAGS" \
  CXXFLAGS="$SLKCFLAGS" \
  meson setup ..\
    "${GNOME_BUILD_ARGS[@]}" \
    $GNOME_OPT_ARGS \
    -Dtests=false
  "${NINJA:=ninja}"
  DESTDIR=$PKG $NINJA install
cd ..
