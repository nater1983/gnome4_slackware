sed -i 's/set(CMAKE_CXX_CLANG_TIDY "${CLANG_TIDY}")/set(CMAKE_CXX_CLANG_TIDY "${CLANG_TIDY}" --allow-no-checks)/' CMakeLists.txt

mkdir cmake-build
cd cmake-build
  cmake .. \
    "${GNOME_CMAKE_ARGS[@]}" \
    "${GNOME_CMAKE_OPT_ARGS[@]}" \
    -DENABLE_CLI=ON \
    -DENABLE_QT=OFF \
    -DENABLE_GTK=ON \
	-DENABLE_TESTS=OFF \
    -DREBUILD_WEB=OFF \
    -DENABLE_DAEMON=ON \
    -DENABLE_CLI=ON \
    -DUSE_SYSTEM_MINIUPNPC=OFF \
    -DUSE_SYSTEM_NATPMP=OFF \
    -DUSE_GTK_VERSION=4
make -C ../cmake-build
make -C ../cmake-build install DESTDIR=$PKG
