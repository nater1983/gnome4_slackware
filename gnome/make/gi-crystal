export release=1
export verbose=1
export interpreter=1
export CXXFLAGS="$SLKCFLAGS"
export LLVM_CONFIG=$(find /usr/bin -name "llvm-config*" -print -quit)
sed -i "s|@LIBDIRSUFFIX@|${LIBDIRSUFFIX}|" src/generator/main.cr
make

install -D -m 755 bin/gi-crystal $PKG/usr/bin/gi-crystal
mkdir -p $PKG/usr/lib${LIBDIRSUFFIX}/gi-crystal
cp -r src $PKG/usr/lib${LIBDIRSUFFIX}/gi-crystal
