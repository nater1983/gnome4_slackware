mkdir -p $PKG/usr/bin
rm bin/{pandoc-lua,pandoc-server}
cp bin/pandoc $PKG/usr/bin/
rm share/man/man1/{pandoc-lua,pandoc-server}.1.gz
mv share/man $PKG/usr/
mkdir -p $PKG/usr/doc/$PKGNAME-$MODULAR_PACKAGE_VERSION
wget -P share/doc/pandoc https://raw.githubusercontent.com/jgm/pandoc/refs/heads/main/{README.md,CONTRIBUTING.md,AUTHORS.md,SECURITY.md,changelog.md}
mv share/doc/pandoc/* $PKG/usr/doc/$PKGNAME-$MODULAR_PACKAGE_VERSION
