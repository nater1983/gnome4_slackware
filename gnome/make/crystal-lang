export release=1
export verbose=1
export interpreter=1
export CXXFLAGS="$SLKCFLAGS"
export LLVM_CONFIG=$(find /usr/bin -name "llvm-config*" -print -quit)
make
make docs

install -D -m 755 bin/crystal $PKG/usr/bin/crystal
install -vDm 644 man/crystal.1 $PKG/usr/man/man1/crystal.1
mkdir -p $PKG/usr/share/crystal/
cp -r src samples $PKG/usr/share/crystal
install -D -m 644 etc/completion.bash $PKG/usr/share/bash-completion/completions/crystal
install -D -m 644 etc/completion.fish $PKG/usr/share/fish/vendor_completions.d/crystal.fish
install -D -m 644 etc/completion.zsh $PKG/usr/share/zsh/site-functions/_crystal
