wget -c -P "$CWD/pre-install/python3-curl_cffi" https://github.com/lexiforest/curl-impersonate/archive/v2.2.2/curl-impersonate-2.2.2.tar.gz
wget -c -P "$CWD/pre-install/python3-curl_cffi" https://github.com/curl/curl/releases/download/curl-8_22_0/curl-8.22.0.tar.gz
tar -xzf $CWD/pre-install/python3-curl_cffi/curl-8.22.0.tar.gz
tar -xzf "$CWD/pre-install/python3-curl_cffi/curl-impersonate-2.2.2.tar.gz"

rm -fr $CWD/pre-install/python3-curl_cffi/curl-impersonate-2.2.2.tar.gz
rm -fr $CWD/pre-install/python3-curl_cffi/curl-8.22.0.tar.gz
rm -fr $CWD/pre-install/python3-curl_cffi/

mv curl-8.22.0 8.22.0

cd curl-impersonate-2.2.2
mkdir -p build
cd build
  cmake \
    -DCMAKE_C_FLAGS:STRING="$SLKCFLAGS" \
    -DCMAKE_CXX_FLAGS:STRING="$SLKCFLAGS" \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DLIB_SUFFIX=${LIBDIRSUFFIX} \
    -DMAN_INSTALL_DIR=/usr/man \
    -DCMAKE_BUILD_TYPE=Release ..
  make
  make install/strip DESTDIR=$PKG
cd ../..

export LIBCURL_IMPERSONATE_PATH=$PKG/

  sed \
    -e "s/@CURL_IMPERSONATE_VERSION@/2.2.2/" \
    -e "s/@CURL_VERSION@/8.22.0/" \
    -i Makefile \
    -i scripts/build.py
