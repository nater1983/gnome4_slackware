config() {
  NEW="$1"
  OLD="$(dirname $NEW)/$(basename $NEW .new)"
  if [ ! -r $OLD ]; then
    mv $NEW $OLD
  elif [ "$(cat $OLD | md5sum)" = "$(cat $NEW | md5sum)" ]; then
    rm $NEW
  fi
}

config etc/gdm/custom.conf.new

# Set the wayland-session script and gdm wrapper executable:
( cd etc/gdm ; chmod 0755 wayland-session )

if [ -e usr/share/glib-2.0/schemas ]; then
  if [ -x /usr/bin/glib-compile-schemas ]; then
    /usr/bin/glib-compile-schemas usr/share/glib-2.0/schemas >/dev/null 2>&1
  fi
fi

if ! grep -q 'pipewire-enabled\.sh' etc/rc.d/rc.local; then
  cat << EOF >> etc/rc.d/rc.local
# Start Updating Pipewire:
if [ -x /usr/sbin/pipewire-enabled.sh ]; then
  echo "Updating Pipewire: /usr/sbin/pipewire-enabled.sh &"
  /usr/sbin/pipewire-enabled.sh
fi
EOF
fi
