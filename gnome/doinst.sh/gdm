config() {
  NEW="$1"
  OLD="$(dirname $NEW)/$(basename $NEW .new)"
  if [ ! -r $OLD ]; then
    mv $NEW $OLD
  elif [ "$(cat $OLD | md5sum)" = "$(cat $NEW | md5sum)" ]; then
    rm $NEW
  fi
}

config etc/gdm/custom.conf.new

sed -i 's/^X-GNOME-Autostart-Phase=.*/#&/' etc/xdg/autostart/*.desktop

if [ -e usr/share/glib-2.0/schemas ]; then
  if [ -x /usr/bin/glib-compile-schemas ]; then
    /usr/bin/glib-compile-schemas usr/share/glib-2.0/schemas >/dev/null 2>&1
  fi
fi

if ! grep -q 'pipewire-enable\.sh' etc/rc.d/rc.local; then
  cat << EOF >> etc/rc.d/rc.local
# Start Updating Pipewire:
if [ -x /usr/sbin/pipewire-enable.sh ]; then
  echo "Updating Pipewire: /usr/sbin/pipewire-enable.sh &"
  /usr/sbin/pipewire-enable.sh
fi
EOF
fi
